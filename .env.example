# Copy to .env (or run `python make_env.py`, which fills every <generate> value for you).
# .env is git-ignored: never commit it.

# ---- Azure OpenAI: one deployment is enough ----
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Use the API version your Azure deployment page shows. GPT-5-family models need a recent one.
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# The agent's model (your deployment NAME in Azure, not the model family).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# The judge / "expensive" model (modules 03, 07, 09, 10, 14). With only one deployment, use the same name.
EVAL_JUDGE_MODEL=gpt-5.4

# ---- Langfuse, self-hosted by ch09/docker-compose.langfuse.yml ----
LANGFUSE_BASE_URL=http://localhost:3000
# The project API key pair. The stack creates the project with exactly these keys on first boot.
LANGFUSE_PUBLIC_KEY=<generate>
LANGFUSE_SECRET_KEY=<generate>
# The first UI login (http://localhost:3000). Any email format works; nothing is sent.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=<generate>
# Internal secrets of the stack (Postgres, ClickHouse, Redis, MinIO, auth, encryption).
LANGFUSE_DB_PASSWORD=<generate>
LANGFUSE_NEXTAUTH_SECRET=<generate>
LANGFUSE_SALT=<generate>
LANGFUSE_ENCRYPTION_KEY=<generate>
LANGFUSE_CLICKHOUSE_PASSWORD=<generate>
LANGFUSE_REDIS_AUTH=<generate>
LANGFUSE_MINIO_ROOT_PASSWORD=<generate>
